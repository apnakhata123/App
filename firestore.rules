rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStudySession(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.category is string && data.category in ['question', 'paper', 'video', 'voice', 'diagram'] &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 10000 &&
             data.answer is string && data.answer.size() <= 50000 &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
             (!('attachmentMimeType' in data) || (data.attachmentMimeType is string && data.attachmentMimeType.size() <= 100)) &&
             data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80 &&
             data.isDeepThinking is bool &&
             data.isBookmarked is bool;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.role is string && data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 50000 &&
             (!('attachmentLabel' in data) || (data.attachmentLabel is string && data.attachmentLabel.size() <= 200)) &&
             data.modelUsed is string && data.modelUsed.size() <= 80 &&
             data.isDeepThinking is bool;
    }

    match /users/{userId}/studySessions/{sessionId} {
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(sessionId) &&
                       incoming().keys().hasAll(['userId', 'title', 'category', 'prompt', 'answer', 'modelUsed', 'isDeepThinking', 'isBookmarked', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'category', 'prompt', 'answer', 'attachmentName', 'attachmentMimeType', 'modelUsed', 'isDeepThinking', 'isBookmarked', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidStudySession(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(sessionId) &&
                       isValidStudySession(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'answer', 'isBookmarked', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(sessionId);
    }

    match /users/{userId}/chatMessages/{messageId} {
      allow get: if isOwner(userId) && isValidId(messageId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(messageId) &&
                       incoming().keys().hasAll(['userId', 'role', 'text', 'modelUsed', 'isDeepThinking', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'role', 'text', 'attachmentLabel', 'modelUsed', 'isDeepThinking', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidChatMessage(incoming(), userId);

      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(messageId);
    }
  }
}
